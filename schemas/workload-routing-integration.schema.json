{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/workload-routing-integration.schema.json",
  "title": "Workload Inventory Routing Integration Extension",
  "type": "object",
  "required": [
    "inventory_version",
    "cluster_id",
    "mutation_allowed",
    "routing_ownership_source_status",
    "routing_ownership_generated_at",
    "routing_service_states",
    "routing_ownership_unknowns",
    "summary",
    "entities"
  ],
  "properties": {
    "inventory_version": {"const": "0.4"},
    "cluster_id": {"type": "string", "minLength": 1},
    "mutation_allowed": {"const": false},
    "routing_ownership_source_status": {"enum": ["COMPLETE", "PARTIAL", "FAILED_TO_OBSERVE"]},
    "routing_ownership_generated_at": {"type": ["string", "null"]},
    "routing_service_states": {
      "type": "array",
      "items": {"$ref": "#/$defs/route"}
    },
    "routing_ownership_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject", "statement"],
        "properties": {
          "code": {"type": "string"},
          "subject": {"type": "string"},
          "statement": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "routing_service_links",
        "workloads_with_routing_service",
        "routing_services_resolved",
        "routing_services_non_pod",
        "routing_services_unknown_or_partial",
        "routing_workloads_not_in_inventory"
      ],
      "properties": {
        "routing_service_links": {"type": "integer", "minimum": 0},
        "workloads_with_routing_service": {"type": "integer", "minimum": 0},
        "routing_services_resolved": {"type": "integer", "minimum": 0},
        "routing_services_non_pod": {"type": "integer", "minimum": 0},
        "routing_services_unknown_or_partial": {"type": "integer", "minimum": 0},
        "routing_workloads_not_in_inventory": {"type": "integer", "minimum": 0}
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "relationships", "evidence_ids"],
        "properties": {
          "relationships": {
            "type": "object",
            "required": ["services", "routing_services"],
            "properties": {
              "routing_services": {
                "type": "array",
                "items": {"$ref": "#/$defs/routingRelation"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resolvedWorkload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "pod_targets", "basis", "evidence_ids"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "pod_targets": {"type": "integer", "minimum": 0},
        "basis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "state", "scope_completeness", "resolved_workloads", "evidence_ids"],
      "properties": {
        "service": {"type": "string", "pattern": "^Service/"},
        "state": {
          "enum": [
            "RESOLVED_WORKLOAD_ROUTING",
            "PARTIAL_ROUTING",
            "NON_POD_ROUTING",
            "NO_ENDPOINTS_OBSERVED",
            "SERVICE_NOT_OBSERVED",
            "UNKNOWN"
          ]
        },
        "scope_completeness": {"enum": ["COMPLETE", "PARTIAL"]},
        "resolved_workloads": {"type": "array", "items": {"$ref": "#/$defs/resolvedWorkload"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "routingRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "state", "scope_completeness", "pod_targets", "basis", "evidence_ids"],
      "properties": {
        "subject": {"type": "string", "pattern": "^Service/"},
        "state": {"const": "RESOLVED_WORKLOAD_ROUTING"},
        "scope_completeness": {"const": "COMPLETE"},
        "pod_targets": {"type": "integer", "minimum": 1},
        "basis": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    }
  }
}
