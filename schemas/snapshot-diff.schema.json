{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/snapshot-diff.schema.json",
  "title": "SnapshotDiff",
  "type": "object",
  "additionalProperties": false,
  "required": ["diff_version", "cluster_id", "generated_at", "baseline", "previous_snapshot_id", "current_snapshot_id", "previous_generated_at", "current_generated_at", "summary", "changes", "unknowns", "collection_failures", "required_live_verification"],
  "properties": {
    "diff_version": {"const": "0.1"},
    "cluster_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "baseline": {"type": "boolean"},
    "previous_snapshot_id": {"type": ["string", "null"]},
    "current_snapshot_id": {"type": "string", "minLength": 1},
    "previous_generated_at": {"type": ["string", "null"], "format": "date-time"},
    "current_generated_at": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "modified", "unchanged", "newly_observed", "unknown_kinds"],
      "properties": {
        "added": {"type": "integer", "minimum": 0},
        "removed": {"type": "integer", "minimum": 0},
        "modified": {"type": "integer", "minimum": 0},
        "unchanged": {"type": "integer", "minimum": 0},
        "newly_observed": {"type": "integer", "minimum": 0},
        "unknown_kinds": {"type": "integer", "minimum": 0}
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "subject", "evidence_ids", "field_changes"],
        "properties": {
          "classification": {"enum": ["ADDED", "REMOVED", "MODIFIED", "NEWLY_OBSERVED"]},
          "subject": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "field_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "previous", "current"],
              "properties": {"field": {"type": "string"}, "previous": {}, "current": {}}
            }
          }
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "object"}},
    "collection_failures": {"type": "array", "items": {"type": "object"}},
    "required_live_verification": {"type": "array", "items": {"type": "object"}}
  }
}
