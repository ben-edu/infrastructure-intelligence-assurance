{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/incident-candidates.schema.json",
  "title": "Incident Candidates and Drill-down",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_candidates_version",
    "cluster_id",
    "generated_at",
    "mutation_allowed",
    "source_status",
    "summary",
    "recommended_next_evidence_targets",
    "candidates",
    "unassociated_change_unknowns",
    "unassociated_required_live_verification",
    "caveats"
  ],
  "properties": {
    "incident_candidates_version": {"const": "0.1"},
    "cluster_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "mutation_allowed": {"const": false},
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alert_attention", "kubernetes_events", "change_context", "drift", "inventory"],
      "properties": {
        "alert_attention": {"enum": ["COMPLETE", "PARTIAL"]},
        "kubernetes_events": {"enum": ["COMPLETE", "PARTIAL", "FAILED_TO_OBSERVE"]},
        "change_context": {"enum": ["COMPLETE", "PARTIAL"]},
        "drift": {
          "enum": [
            "DECLARED_STATE_UNAVAILABLE",
            "DECLARED_STATE_OBSERVATION_FAILED",
            "DECLARED_STATE_ERRORS",
            "EVALUATED",
            "EVALUATED_PARTIAL",
            "UNKNOWN"
          ]
        },
        "inventory": {"const": "COMPLETE"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_attention_records",
        "incident_candidates",
        "active_candidates",
        "suppressed_candidates",
        "unknown_candidates",
        "candidates_with_related_warning_events",
        "candidates_with_exact_recent_change",
        "candidates_with_exact_drift",
        "candidates_with_related_workloads",
        "candidates_requiring_live_verification"
      ],
      "properties": {
        "alert_attention_records": {"type": "integer", "minimum": 0},
        "incident_candidates": {"type": "integer", "minimum": 0},
        "active_candidates": {"type": "integer", "minimum": 0},
        "suppressed_candidates": {"type": "integer", "minimum": 0},
        "unknown_candidates": {"type": "integer", "minimum": 0},
        "candidates_with_related_warning_events": {"type": "integer", "minimum": 0},
        "candidates_with_exact_recent_change": {"type": "integer", "minimum": 0},
        "candidates_with_exact_drift": {"type": "integer", "minimum": 0},
        "candidates_with_related_workloads": {"type": "integer", "minimum": 0},
        "candidates_requiring_live_verification": {"type": "integer", "minimum": 0}
      }
    },
    "recommended_next_evidence_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "candidate_checks"],
        "properties": {
          "target": {"type": "string", "minLength": 1},
          "candidate_checks": {"type": "integer", "minimum": 1}
        }
      }
    },
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "unassociated_change_unknowns": {"type": "array", "items": {"type": "object"}},
    "unassociated_required_live_verification": {"type": "array", "items": {"type": "object"}},
    "caveats": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject", "basis"],
      "properties": {
        "type": {"enum": ["WORKLOAD", "NODE", "SERVICE", "NAMESPACE", "PLATFORM"]},
        "subject": {"type": "string", "minLength": 1},
        "basis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attention_id", "handling_state", "alertname", "severity", "starts_at", "evidence_ids"],
      "properties": {
        "attention_id": {"type": ["string", "null"]},
        "handling_state": {"enum": ["ACTIVE", "SILENCED", "INHIBITED", "SILENCED_AND_INHIBITED", "SUPPRESSED_OTHER", "UNPROCESSED", "UNKNOWN"]},
        "alertname": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "starts_at": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "relatedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "subject", "reason", "last_seen", "count", "basis", "evidence_ids"],
      "properties": {
        "event_id": {"type": ["string", "null"]},
        "subject": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "last_seen": {"type": ["string", "null"]},
        "count": {"type": "integer", "minimum": 1},
        "basis": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "basis", "observed_freshness", "declared_coverage", "declared_comparison", "prometheus_runtime_state", "evidence_ids"],
      "properties": {
        "subject": {"type": "string"},
        "basis": {"type": "array", "items": {"type": "string"}},
        "observed_freshness": {"type": ["string", "null"]},
        "declared_coverage": {"type": ["string", "null"]},
        "declared_comparison": {"type": ["string", "null"]},
        "prometheus_runtime_state": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "basis", "evidence_ids"],
      "properties": {
        "subject": {"type": "string"},
        "basis": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "related_workloads_total",
        "related_workloads",
        "related_workloads_truncated",
        "ingress_route_candidates",
        "ingress_route_candidates_truncated",
        "persistent_volume_claims",
        "persistent_volume_claims_truncated",
        "platform_context",
        "basis",
        "caveat"
      ],
      "properties": {
        "related_workloads_total": {"type": "integer", "minimum": 0},
        "related_workloads": {"type": "array", "items": {"$ref": "#/$defs/workload"}},
        "related_workloads_truncated": {"type": "boolean"},
        "ingress_route_candidates": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "ingress_route_candidates_truncated": {"type": "boolean"},
        "persistent_volume_claims": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "persistent_volume_claims_truncated": {"type": "boolean"},
        "platform_context": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["workloads_total", "namespaces_total"],
              "properties": {
                "workloads_total": {"type": "integer", "minimum": 0},
                "namespaces_total": {"type": "integer", "minimum": 0}
              }
            }
          ]
        },
        "basis": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "caveat": {"type": "string"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "target", "check", "rationale", "live_verification_required", "evidence_ids"],
      "properties": {
        "code": {"type": "string"},
        "target": {"type": "string"},
        "check": {"type": "string"},
        "rationale": {"type": "string"},
        "live_verification_required": {"const": true},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "scope",
        "state",
        "alert_count",
        "alerts",
        "event_correlation_statuses",
        "related_warning_events",
        "recent_changes",
        "drift_attention",
        "impact_context",
        "recommended_checks",
        "evidence_ids",
        "caveats"
      ],
      "properties": {
        "candidate_id": {"type": "string"},
        "scope": {"$ref": "#/$defs/scope"},
        "state": {"enum": ["ACTIVE", "SUPPRESSED", "UNKNOWN"]},
        "alert_count": {"type": "integer", "minimum": 1},
        "alerts": {"type": "array", "items": {"$ref": "#/$defs/alert"}, "minItems": 1},
        "event_correlation_statuses": {"type": "array", "items": {"enum": ["MATCHED", "NO_DIRECT_EVENT_MATCH", "UNKNOWN"]}, "uniqueItems": true},
        "related_warning_events": {"type": "array", "items": {"$ref": "#/$defs/relatedEvent"}},
        "recent_changes": {"type": "array", "items": {"type": "object"}},
        "drift_attention": {"type": "array", "items": {"type": "object"}},
        "impact_context": {"$ref": "#/$defs/impact"},
        "recommended_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "caveats": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
