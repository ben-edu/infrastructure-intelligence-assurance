{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/hypothetical-deployment-request.schema.json",
  "title": "Hypothetical Kubernetes Application Deployment Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_version",
    "type",
    "cluster_id",
    "namespace",
    "application",
    "deployment"
  ],
  "properties": {
    "request_version": {"const": "0.1"},
    "type": {"const": "hypothetical_kubernetes_application_deployment"},
    "cluster_id": {"type": "string", "minLength": 1},
    "namespace": {"type": "string", "minLength": 1},
    "application": {"type": "string", "minLength": 1},
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "replicas", "image"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "replicas": {"type": "integer", "minimum": 1},
        "image": {"type": "string", "minLength": 1}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "port", "target_port"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "target_port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "host": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "pvc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size": {"type": "string", "minLength": 1},
        "storage_class": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["ingress"]},
      "then": {"required": ["service"]}
    }
  ]
}
