{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soria.local/schemas/mariadb-infrastructure-recovery-context.schema.json",
  "title": "MariaDB Infrastructure Recovery Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mariadb_infrastructure_recovery_context_version",
    "generated_at",
    "mutation_allowed",
    "scope",
    "source_status",
    "instances",
    "summary",
    "unknowns",
    "caveats"
  ],
  "properties": {
    "mariadb_infrastructure_recovery_context_version": {"const": "0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mutation_allowed": {"const": false},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database_engine",
        "platform",
        "cluster_id",
        "derived_only",
        "database_aware_backup_source_integrated",
        "management_host_mariadb_included"
      ],
      "properties": {
        "database_engine": {"const": "MARIADB_COMPATIBLE"},
        "platform": {"const": "KUBERNETES"},
        "cluster_id": {"type": "string", "minLength": 1},
        "derived_only": {"const": true},
        "database_aware_backup_source_integrated": {"const": false},
        "management_host_mariadb_included": {"const": false}
      }
    },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_evidence", "vm_backup_assurance"],
      "properties": {
        "relationship_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "source_type", "source_id", "status", "generated_at"],
          "properties": {
            "version": {"const": "0.1"},
            "source_type": {"const": "BOUNDED_KUBERNETES_PVE_RELATIONSHIP_OBSERVATION"},
            "source_id": {"type": "string", "minLength": 1},
            "status": {"enum": ["COMPLETE", "PARTIAL", "FAILED_TO_OBSERVE"]},
            "generated_at": {"type": ["string", "null"], "format": "date-time"}
          }
        },
        "vm_backup_assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "source_id", "status", "generated_at", "integration_mode", "freshness"],
          "properties": {
            "version": {"const": "0.2"},
            "source_id": {"type": "string", "minLength": 1},
            "status": {"enum": ["COMPLETE", "INCOMPLETE"]},
            "generated_at": {"type": ["string", "null"], "format": "date-time"},
            "integration_mode": {"const": "STRICT_CORRELATION_ONLY"},
            "freshness": {"enum": ["CURRENT", "STALE", "UNKNOWN"]}
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "subject",
          "instance_observation_status",
          "persistence",
          "infrastructure_recovery",
          "mariadb_assurance",
          "required_evidence"
        ],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "subject": {
            "type": "object",
            "additionalProperties": true,
            "required": ["system", "cluster", "database_engine", "namespace", "workload_kind", "workload_name"],
            "properties": {
              "system": {"const": "kubernetes"},
              "cluster": {"type": "string", "minLength": 1},
              "database_engine": {"const": "MARIADB_COMPATIBLE"},
              "namespace": {"type": "string", "minLength": 1},
              "workload_kind": {"enum": ["Deployment", "StatefulSet"]},
              "workload_name": {"type": "string", "minLength": 1},
              "container_name": {"type": ["string", "null"]},
              "image": {"type": ["string", "null"]}
            }
          },
          "instance_observation_status": {"enum": ["OBSERVED", "UNKNOWN", "FAILED_TO_OBSERVE"]},
          "persistence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "pvc_name", "pvc_phase", "storage_class", "pv_name", "storage_node"],
            "properties": {
              "status": {"enum": ["OBSERVED", "UNKNOWN", "FAILED_TO_OBSERVE"]},
              "pvc_name": {"type": ["string", "null"]},
              "pvc_phase": {"type": ["string", "null"]},
              "storage_class": {"type": ["string", "null"]},
              "pv_name": {"type": ["string", "null"]},
              "storage_node": {"type": ["string", "null"]}
            }
          },
          "infrastructure_recovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relationship_status",
              "kubernetes_node",
              "pve_source_id",
              "pve_node",
              "vmid",
              "underlying_vm_last_successful_backup_status",
              "underlying_vm_last_successful_backup_at",
              "underlying_vm_last_successful_backup_evidence",
              "basis",
              "evidence_ids"
            ],
            "properties": {
              "relationship_status": {"enum": ["OBSERVED", "UNKNOWN", "FAILED_TO_OBSERVE"]},
              "kubernetes_node": {"type": ["string", "null"]},
              "pve_source_id": {"type": ["string", "null"]},
              "pve_node": {"type": ["string", "null"]},
              "vmid": {"type": ["integer", "null"], "minimum": 1},
              "underlying_vm_last_successful_backup_status": {"enum": ["OBSERVED", "UNKNOWN"]},
              "underlying_vm_last_successful_backup_at": {"type": ["string", "null"], "format": "date-time"},
              "underlying_vm_last_successful_backup_evidence": {
                "oneOf": [
                  {"type": "null"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["source_type", "source_id", "recovery_point_id", "task_result_id", "basis"],
                    "properties": {
                      "source_type": {"const": "PROXMOX_VE_VZDUMP_TASK_RESULT"},
                      "source_id": {"type": "string", "minLength": 1},
                      "recovery_point_id": {"type": "string", "pattern": "^pve-rp-[a-f0-9]{24}$"},
                      "task_result_id": {"type": "string", "pattern": "^pve-backup-task:[a-f0-9]{24}$"},
                      "basis": {
                        "type": "array",
                        "items": {"const": "STRICT_SUCCESS_TASK_MATCH"},
                        "minItems": 1,
                        "maxItems": 1
                      }
                    }
                  }
                ]
              },
              "basis": {
                "type": "array",
                "items": {
                  "enum": [
                    "MARIADB_COMPATIBLE_WORKLOAD_OBSERVED",
                    "PERSISTENT_PVC_OBSERVED",
                    "PV_STORAGE_NODE_OBSERVED",
                    "KUBERNETES_NODE_TO_PVE_VMID_OBSERVED",
                    "VM_LAST_SUCCESSFUL_BACKUP_OBSERVED"
                  ]
                },
                "uniqueItems": true
              },
              "evidence_ids": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            }
          },
          "mariadb_assurance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protection_status",
              "backup_mechanism_status",
              "backup_execution_status",
              "backup_artifact_location_status",
              "retention_effectiveness_status",
              "restore_verification_status",
              "integrity_verification_status",
              "rpo_status",
              "rto_status",
              "basis",
              "statement"
            ],
            "properties": {
              "protection_status": {"const": "UNKNOWN"},
              "backup_mechanism_status": {"const": "UNKNOWN"},
              "backup_execution_status": {"const": "UNKNOWN"},
              "backup_artifact_location_status": {"const": "UNKNOWN"},
              "retention_effectiveness_status": {"const": "UNKNOWN"},
              "restore_verification_status": {"const": "UNKNOWN"},
              "integrity_verification_status": {"const": "UNKNOWN"},
              "rpo_status": {"const": "UNKNOWN"},
              "rto_status": {"const": "RTO_UNKNOWN"},
              "basis": {
                "type": "array",
                "items": {"const": "DATABASE_AWARE_BACKUP_SOURCE_NOT_INTEGRATED"},
                "minItems": 1,
                "maxItems": 1
              },
              "statement": {"type": "string", "minLength": 1}
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "status", "statement"],
              "properties": {
                "target": {"type": "string", "minLength": 1},
                "status": {"const": "REQUIRED"},
                "statement": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instances_total",
        "persistence_observed",
        "persistence_unknown",
        "persistence_failed_to_observe",
        "infrastructure_recovery_observed",
        "infrastructure_recovery_unknown",
        "infrastructure_recovery_failed_to_observe",
        "underlying_vm_last_successful_backup_observed",
        "mariadb_protection_unknown",
        "mariadb_backup_mechanism_unknown",
        "mariadb_backup_execution_unknown",
        "mariadb_restore_verification_unknown",
        "mariadb_integrity_verification_unknown",
        "mariadb_rpo_unknown",
        "mariadb_rto_unknown",
        "unprotected_claims",
        "backup_stale_claims",
        "rpo_violation_claims"
      ],
      "properties": {
        "instances_total": {"type": "integer", "minimum": 0},
        "persistence_observed": {"type": "integer", "minimum": 0},
        "persistence_unknown": {"type": "integer", "minimum": 0},
        "persistence_failed_to_observe": {"type": "integer", "minimum": 0},
        "infrastructure_recovery_observed": {"type": "integer", "minimum": 0},
        "infrastructure_recovery_unknown": {"type": "integer", "minimum": 0},
        "infrastructure_recovery_failed_to_observe": {"type": "integer", "minimum": 0},
        "underlying_vm_last_successful_backup_observed": {"type": "integer", "minimum": 0},
        "mariadb_protection_unknown": {"type": "integer", "minimum": 0},
        "mariadb_backup_mechanism_unknown": {"type": "integer", "minimum": 0},
        "mariadb_backup_execution_unknown": {"type": "integer", "minimum": 0},
        "mariadb_restore_verification_unknown": {"type": "integer", "minimum": 0},
        "mariadb_integrity_verification_unknown": {"type": "integer", "minimum": 0},
        "mariadb_rpo_unknown": {"type": "integer", "minimum": 0},
        "mariadb_rto_unknown": {"type": "integer", "minimum": 0},
        "unprotected_claims": {"const": 0},
        "backup_stale_claims": {"const": 0},
        "rpo_violation_claims": {"const": 0}
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "subject", "status", "statement"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "subject": {"type": ["string", "null"]},
          "status": {"enum": ["UNKNOWN", "FAILED_TO_OBSERVE"]},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "caveats": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
