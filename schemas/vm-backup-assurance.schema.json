{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soria.local/schemas/vm-backup-assurance.schema.json",
  "title": "Virtual Machine Backup Assurance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vm_backup_assurance_version",
    "generated_at",
    "mutation_allowed",
    "scope",
    "source_status",
    "summary",
    "assets",
    "unknowns",
    "caveats"
  ],
  "properties": {
    "vm_backup_assurance_version": {"const": "0.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "mutation_allowed": {"const": false},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_type", "derived_only", "source_neutral_assurance", "kubernetes_pvc_assurance_modified"],
      "properties": {
        "asset_type": {"const": "VIRTUAL_MACHINE"},
        "derived_only": {"const": true},
        "source_neutral_assurance": {"const": true},
        "kubernetes_pvc_assurance_modified": {"const": false}
      }
    },
    "source_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "source_type", "source_id", "source_artifact_version", "source_generated_at", "source_freshness", "guest_inventory"],
      "properties": {
        "overall": {"enum": ["COMPLETE", "PARTIAL", "FAILED_TO_OBSERVE"]},
        "source_type": {"const": "PROXMOX_VE"},
        "source_id": {"type": "string", "minLength": 1},
        "source_artifact_version": {"const": "0.1"},
        "source_generated_at": {"type": ["string", "null"], "format": "date-time"},
        "source_freshness": {"const": "UNKNOWN"},
        "guest_inventory": {"enum": ["COMPLETE", "PARTIAL", "FAILED_TO_OBSERVE"]}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assets_total",
        "recovery_point_observed",
        "scoped_negative_recovery_point",
        "recovery_point_unknown",
        "backup_mechanism_observed",
        "retention_configuration_observed",
        "protection_unknown",
        "restore_verification_unknown",
        "integrity_verification_unknown",
        "rpo_unknown",
        "rto_unknown",
        "unprotected_claims",
        "authoritative_source_artifacts_consumed",
        "kubernetes_pvc_assets_modified"
      ],
      "properties": {
        "assets_total": {"type": "integer", "minimum": 0},
        "recovery_point_observed": {"type": "integer", "minimum": 0},
        "scoped_negative_recovery_point": {"type": "integer", "minimum": 0},
        "recovery_point_unknown": {"type": "integer", "minimum": 0},
        "backup_mechanism_observed": {"type": "integer", "minimum": 0},
        "retention_configuration_observed": {"type": "integer", "minimum": 0},
        "protection_unknown": {"type": "integer", "minimum": 0},
        "restore_verification_unknown": {"type": "integer", "minimum": 0},
        "integrity_verification_unknown": {"type": "integer", "minimum": 0},
        "rpo_unknown": {"type": "integer", "minimum": 0},
        "rto_unknown": {"type": "integer", "minimum": 0},
        "unprotected_claims": {"const": 0},
        "authoritative_source_artifacts_consumed": {"const": 1},
        "kubernetes_pvc_assets_modified": {"const": 0}
      }
    },
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "unknowns": {"type": "array", "items": {"$ref": "#/$defs/unknown"}},
    "caveats": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "source_id", "kind", "node", "vmid", "guest_type", "guest_status"],
      "properties": {
        "system": {"const": "proxmox_ve"},
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"const": "VirtualMachine"},
        "node": {"type": "string", "minLength": 1},
        "vmid": {"type": "integer", "minimum": 1},
        "guest_type": {"type": "string", "minLength": 1},
        "guest_status": {"type": "string", "minLength": 1}
      }
    },
    "selected_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "storage_id", "status"],
      "properties": {
        "node": {"type": ["string", "null"]},
        "storage_id": {"type": ["string", "null"]},
        "status": {"enum": ["COMPLETE", "UNKNOWN"]}
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "source_artifact_version", "source_status", "source_generated_at", "selected_storage_scopes"],
      "properties": {
        "source_type": {"const": "PROXMOX_VE"},
        "source_id": {"type": "string", "minLength": 1},
        "source_artifact_version": {"const": "0.1"},
        "source_status": {"enum": ["COMPLETE", "PARTIAL", "FAILED_TO_OBSERVE"]},
        "source_generated_at": {"type": ["string", "null"], "format": "date-time"},
        "selected_storage_scopes": {"type": "array", "items": {"$ref": "#/$defs/selected_scope"}}
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source_type", "source_id", "node", "storage_id", "basis"],
      "properties": {
        "type": {"const": "PROXMOX_VE_STORAGE_ARCHIVE"},
        "source_type": {"const": "PROXMOX_VE"},
        "source_id": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1},
        "storage_id": {"type": "string", "minLength": 1},
        "basis": {
          "type": "array",
          "items": {"const": "RECOVERY_POINT_OBSERVED_IN_SOURCE_SCOPE"},
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_id", "configuration_status", "retention_policy", "effectiveness_status"],
      "properties": {
        "storage_id": {"type": "string", "minLength": 1},
        "configuration_status": {"enum": ["OBSERVED", "UNKNOWN"]},
        "retention_policy": {"type": ["string", "null"]},
        "effectiveness_status": {"const": "UNKNOWN"}
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protection_status",
        "recovery_point_status",
        "recovery_point_count",
        "latest_recovery_point_at",
        "backup_mechanism_status",
        "backup_mechanisms",
        "retention_context",
        "last_successful_backup_status",
        "integrity_verification_status",
        "restore_verification_status",
        "failure_domain_status",
        "scheduled_protection_status",
        "rpo_status",
        "rto_status",
        "basis",
        "statement"
      ],
      "properties": {
        "protection_status": {"const": "UNKNOWN"},
        "recovery_point_status": {"enum": ["OBSERVED", "NOT_OBSERVED_IN_COMPLETE_SELECTED_SCOPE", "UNKNOWN"]},
        "recovery_point_count": {"type": "integer", "minimum": 0},
        "latest_recovery_point_at": {"type": ["string", "null"], "format": "date-time"},
        "backup_mechanism_status": {"enum": ["OBSERVED", "UNKNOWN"]},
        "backup_mechanisms": {"type": "array", "items": {"$ref": "#/$defs/mechanism"}},
        "retention_context": {"type": "array", "items": {"$ref": "#/$defs/retention"}},
        "last_successful_backup_status": {"const": "UNKNOWN"},
        "integrity_verification_status": {"const": "UNKNOWN"},
        "restore_verification_status": {"const": "UNKNOWN"},
        "failure_domain_status": {"const": "UNKNOWN"},
        "scheduled_protection_status": {"const": "UNKNOWN"},
        "rpo_status": {"const": "UNKNOWN"},
        "rto_status": {"const": "RTO_UNKNOWN"},
        "basis": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "enum": [
              "AUTHORITATIVE_RECOVERY_POINT_OBSERVED",
              "COMPLETE_SELECTED_SOURCE_SCOPE_NO_RECOVERY_POINT_OBSERVED",
              "SELECTED_SOURCE_SCOPE_INCOMPLETE_OR_UNKNOWN"
            ]
          }
        },
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "required_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "statement"],
      "properties": {
        "target": {
          "enum": [
            "BACKUP_MECHANISM",
            "LAST_SUCCESSFUL_BACKUP",
            "BACKUP_RETENTION",
            "BACKUP_FAILURE_DOMAIN",
            "BACKUP_INTEGRITY_VERIFICATION",
            "RESTORE_TEST",
            "RPO_TARGET_AND_RESULT",
            "RTO_TARGET_AND_RESULT"
          ]
        },
        "status": {"enum": ["OBSERVED", "PARTIAL", "REQUIRED"]},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "asset_type",
        "subject",
        "existence",
        "observation_status",
        "freshness",
        "source_context",
        "assurance",
        "required_evidence",
        "source_recovery_point_ids"
      ],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "asset_type": {"const": "VIRTUAL_MACHINE"},
        "subject": {"$ref": "#/$defs/subject"},
        "existence": {"const": "PRESENT"},
        "observation_status": {"enum": ["COMPLETE", "PARTIAL"]},
        "freshness": {"const": "UNKNOWN"},
        "source_context": {"$ref": "#/$defs/source_context"},
        "assurance": {"$ref": "#/$defs/assurance"},
        "required_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/required_evidence"},
          "minItems": 8,
          "maxItems": 8
        },
        "source_recovery_point_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "subject", "statement"],
      "properties": {
        "code": {
          "enum": [
            "SOURCE_ARTIFACT_FRESHNESS_UNKNOWN",
            "OTHER_BACKUP_SOURCES_NOT_EVALUATED",
            "RESTORE_INTEGRITY_RPO_RTO_REMAIN_UNKNOWN",
            "PVE_SOURCE_NOT_COMPLETE",
            "PVE_GUEST_INVENTORY_FAILED_TO_OBSERVE"
          ]
        },
        "subject": {"type": ["string", "null"]},
        "statement": {"type": "string", "minLength": 1}
      }
    }
  }
}
