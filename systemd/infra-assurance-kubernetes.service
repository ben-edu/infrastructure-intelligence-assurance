[Unit]
Description=Infrastructure Assurance Kubernetes evidence collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=infra-assurance
Group=infra-assurance
EnvironmentFile=/etc/infra-assurance/collector.env
Environment=PYTHONPATH=/opt/infra-assurance/src
ExecStartPre=-/usr/bin/python3 -m infra_assurance.git_declared_observer sync --config /etc/infra-assurance/git-source.json --state-dir /var/lib/infra-assurance/git --declared-dir /var/lib/infra-assurance/declared/current --source-status /var/lib/infra-assurance/declared/source-status.json
ExecStart=/usr/bin/python3 -m infra_assurance.kubernetes_runtime --evidence-out /var/lib/infra-assurance/evidence/kubernetes.json --context-out /var/lib/infra-assurance/evidence/context.json --summary-out /var/lib/infra-assurance/evidence/context.md --topology-out /var/lib/infra-assurance/evidence/topology.json --topology-summary-out /var/lib/infra-assurance/evidence/topology.md --history-dir /var/lib/infra-assurance/history/kubernetes --diff-out /var/lib/infra-assurance/evidence/diff.json --diff-summary-out /var/lib/infra-assurance/evidence/diff.md --declared-dir /var/lib/infra-assurance/declared/current --declared-status /var/lib/infra-assurance/declared/source-status.json --drift-out /var/lib/infra-assurance/evidence/drift.json --drift-summary-out /var/lib/infra-assurance/evidence/drift.md --change-context-out /var/lib/infra-assurance/evidence/change-context.json --change-context-summary-out /var/lib/infra-assurance/evidence/change-context.md --observability-coverage-out /var/lib/infra-assurance/evidence/observability-coverage.json --observability-coverage-summary-out /var/lib/infra-assurance/evidence/observability-coverage.md --prometheus-runtime-out /var/lib/infra-assurance/evidence/prometheus-runtime.json --prometheus-runtime-summary-out /var/lib/infra-assurance/evidence/prometheus-runtime.md --alertmanager-runtime-out /var/lib/infra-assurance/evidence/alertmanager-runtime.json --alertmanager-runtime-summary-out /var/lib/infra-assurance/evidence/alertmanager-runtime.md --alert-attention-out /var/lib/infra-assurance/evidence/alert-attention.json --alert-attention-summary-out /var/lib/infra-assurance/evidence/alert-attention.md --kubernetes-event-runtime-out /var/lib/infra-assurance/evidence/kubernetes-event-runtime.json --kubernetes-event-runtime-summary-out /var/lib/infra-assurance/evidence/kubernetes-event-runtime.md --event-correlation-out /var/lib/infra-assurance/evidence/kubernetes-event-correlation.json --event-correlation-summary-out /var/lib/infra-assurance/evidence/kubernetes-event-correlation.md --inventory-out /var/lib/infra-assurance/evidence/inventory.json --inventory-summary-out /var/lib/infra-assurance/evidence/inventory.md
ExecStartPost=/usr/bin/python3 -m infra_assurance.routing_ownership --snapshot /var/lib/infra-assurance/evidence/kubernetes.json --out /var/lib/infra-assurance/evidence/kubernetes-routing-ownership.json --summary-out /var/lib/infra-assurance/evidence/kubernetes-routing-ownership.md
ExecStartPost=/usr/bin/python3 -m infra_assurance.alert_scope_runtime --attention /var/lib/infra-assurance/evidence/alert-attention.json --snapshot /var/lib/infra-assurance/evidence/kubernetes.json --event-runtime /var/lib/infra-assurance/evidence/kubernetes-event-runtime.json --event-correlation-out /var/lib/infra-assurance/evidence/kubernetes-event-correlation.json --attention-summary-out /var/lib/infra-assurance/evidence/alert-attention.md --event-correlation-summary-out /var/lib/infra-assurance/evidence/kubernetes-event-correlation.md
ExecStartPost=/usr/bin/python3 -m infra_assurance.incident_runtime --alert-attention /var/lib/infra-assurance/evidence/alert-attention.json --event-correlation /var/lib/infra-assurance/evidence/kubernetes-event-correlation.json --inventory /var/lib/infra-assurance/evidence/inventory.json --change-context /var/lib/infra-assurance/evidence/change-context.json --out /var/lib/infra-assurance/evidence/incident-candidates.json --summary-out /var/lib/infra-assurance/evidence/incident-candidates.md
ExecStartPost=/usr/bin/python3 -m infra_assurance.routing_context_integration --inventory /var/lib/infra-assurance/evidence/inventory.json --routing /var/lib/infra-assurance/evidence/kubernetes-routing-ownership.json --incident /var/lib/infra-assurance/evidence/incident-candidates.json --inventory-summary /var/lib/infra-assurance/evidence/inventory.md --incident-summary /var/lib/infra-assurance/evidence/incident-candidates.md
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/infra-assurance/evidence /var/lib/infra-assurance/history /var/lib/infra-assurance/git /var/lib/infra-assurance/declared
ReadOnlyPaths=/etc/infra-assurance

[Install]
WantedBy=multi-user.target
